{
  "name": "@hexafield/ad4m-rag",
  "version": "0.0.0",
  "description": "GraphRAG-style knowledge extraction and query, backed by AD4M perspectives.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PLAN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "graphrag",
    "rag",
    "ad4m",
    "knowledge-graph",
    "p2p",
    "embeddings",
    "leiden",
    "holochain"
  ],
  "author": "Josh Field",
  "license": "CAL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HexaField/ad4m-rag.git"
  },
  "homepage": "https://github.com/HexaField/ad4m-rag",
  "bugs": {
    "url": "https://github.com/HexaField/ad4m-rag/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "leiden-ts": "^0.1.0",
    "sqlite-vec": "^0.1.6"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@coasys/ad4m": ">=0.13.0-test-8"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@coasys/ad4m": ">=0.13.0-test-8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.7.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
